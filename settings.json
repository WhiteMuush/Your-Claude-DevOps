{
  "permissions": {
    "allow": [
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh issue *)",
      "Bash(git *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "effortLevel": "xhigh",
  "theme": "dark-ansi",
  "showTurnDuration": true,
  "disableAgentView": true,
  "skipAutoPermissionPrompt": true,
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"__HOME__/.claude/hooks/caveman-statusline.sh\""
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(docker swarm init --force-new-cluster:*) and similar quorum-override Swarm commands",
      "Bash(argocd app set * --sync-policy none:*) and other ArgoCD auto-sync disabling commands"
    ]
  }
}
