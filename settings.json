{
  "permissions": {
    "allow": [
      "Bash(gh:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git clone:*)",
      "Edit(.github/**)",
      "Write(.github/**)"
    ],
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "light",
  "skipAutoPermissionPrompt": true
}
